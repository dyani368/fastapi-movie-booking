DATABASE_URL=postgresql://user:password@localhost:5432/movie_booking
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURE_COOKIES=false

# TMDB server-side movie catalog search/import
TMDB_API_KEY=

# Razorpay test mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth web application. Add GOOGLE_REDIRECT_URI to the OAuth client's
# authorized redirect URIs exactly as written below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback
FRONTEND_URL=http://localhost:5173

BOOKING_HOLD_MINUTES=10
